<xml>

    <!-- Dear ImGui (docking branch) + the dear_bindings C API (dcimgui), compiled from
         source on every hxcpp target. No imgui_impl_* platform/renderer backends are
         compiled anymore: rendering and input go through the engine (ceramic Renderable
         + input bridge), which is what makes the plugin cross-backend. -->
    <set name="IMGUI" value="${LINC_IMGUI_PATH}lib/imgui" />
    <set name="DCIMGUI" value="${LINC_IMGUI_PATH}lib/dcimgui" />

    <files id="haxe">

        <!-- add files and flags to the haxe c++ build -->

        <compilerflag value="-I${LINC_IMGUI_PATH}src/imguicpp/linc/"/>
        <compilerflag value="-I${IMGUI}/" />
        <compilerflag value="-I${DCIMGUI}/" />
        <compilerflag value="-DIMGUI_DISABLE_OBSOLETE_FUNCTIONS"/>

    </files>

    <files id="__main__">

        <!-- the entry-point translation unit includes the app class header too -->

        <compilerflag value="-I${LINC_IMGUI_PATH}src/imguicpp/linc/"/>
        <compilerflag value="-I${IMGUI}/" />
        <compilerflag value="-I${DCIMGUI}/" />
        <compilerflag value="-DIMGUI_DISABLE_OBSOLETE_FUNCTIONS"/>

    </files>

    <files id="imgui-sources">
        <cache value="1" name="imgui" />

        <compilerflag value="-DIMGUI_DISABLE_OBSOLETE_FUNCTIONS"/>
        <compilerflag value="-I${IMGUI}/" />
        <compilerflag value="-I${DCIMGUI}/" />

        <file name="${IMGUI}/imgui.cpp" />
        <file name="${IMGUI}/imgui_draw.cpp" />
        <file name="${IMGUI}/imgui_demo.cpp" />
        <file name="${IMGUI}/imgui_tables.cpp" />
        <file name="${IMGUI}/imgui_widgets.cpp" />

        <file name="${DCIMGUI}/dcimgui.cpp" />
        <file name="${DCIMGUI}/dcimgui_extra_glue.cpp" />
        <file name="${DCIMGUI}/dcimgui_extra_ctors.cpp" />

        <file name="${LINC_IMGUI_PATH}src/imguicpp/linc/linc_imgui.cpp" />

    </files>

    <target id="haxe">

        <!-- add linker flags to the haxe build output -->
        <files id="imgui-sources" />

    </target>

</xml>
