# Single source of truth for the CI prebuilt matrix (.github/workflows/prebuilt.yml).
#
# Flat KEY=VALUE, no shell expansion: this file is both sourced by the workflow
# and hashed by build/stamp.sh.
#
# build/stamp.sh hashes ONLY the COMMON_* lines plus the <PLATFORM>_* lines of the
# platform it stamps. So bumping WEB_EMSDK invalidates web alone, while bumping
# COMMON_BUILD_REVISION invalidates all six platforms. That is what makes a
# toolchain change an explicit, reviewable, correctly scoped rebuild instead of a
# silent drift: without it, a runner image upgrade would change the bytes we ship
# to users without changing any stamp.
#
# Pin everything. Never use a *-latest runner label here.

# Bump to force a rebuild of every platform (e.g. after changing stamp.sh itself).
COMMON_BUILD_REVISION=1
# Bump if the stamp INPUT SET or digest layout changes (invalidates everything).
COMMON_STAMP_FORMAT=1

MAC_RUNNER=macos-14
MAC_MIN_OS=11.0
MAC_OUTPUTS=mac/dcimgui.dylib

IOS_RUNNER=macos-14
IOS_MIN_OS=12.0
IOS_OUTPUTS=ios/dcimgui.xcframework

# Oldest hosted image still offered: the .so must not require a newer glibc than
# the distros Unity Linux players run on. Do NOT move this to ubuntu-24.04 when
# 22.04 retires; use a manylinux container instead.
LINUX_RUNNER=ubuntu-22.04
LINUX_OUTPUTS=linux/libdcimgui.so

WINDOWS_RUNNER=windows-2022
WINDOWS_OUTPUTS=windows/dcimgui.dll

ANDROID_RUNNER=ubuntu-24.04
ANDROID_NDK=28.2.13676358
# Quoted: this file is sourced by the shell, so a multi valued entry must not
# look like an assignment followed by a command.
ANDROID_OUTPUTS="android/arm64-v8a/libdcimgui.so android/armeabi-v7a/libdcimgui.so android/x86_64/libdcimgui.so"

WEB_RUNNER=ubuntu-24.04
# Matches the emcc used locally to produce the committed dcimgui.js.
WEB_EMSDK=5.0.2
WEB_OUTPUTS=web/dcimgui.js
